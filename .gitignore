# Hugo generated output and caches
/public/
/resources/_gen/
/.hugo_build.lock
/hugo_stats.json

# Private FIG preview inputs, copied images, translations and build output
/.gallery-local/

# Disposable analytics previews, test fixtures and local diagnostics
/.analytics-local/

# Local Python importer/test caches
__pycache__/
*.py[cod]

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Private credentials and source papers are never website source files
.env
.env.*
*.pem
*.key
*.pdf
